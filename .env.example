# Copy this file to ".env" for local runs and fill in real values.
# NEVER commit a real .env or paste real keys into chat/repo files.
# On Render, set these same names under the service's Environment tab.

# Flask secret — signs the download tokens. Use a long random string.
# (On Render this is auto-generated from render.yaml.)
SECRET_KEY=change-me-to-a-long-random-string

# Public URL of this app once deployed, e.g. https://ebook-store.onrender.com
# Stripe sends buyers back to <APP_BASE_URL>/success after checkout.
APP_BASE_URL=http://localhost:5000

# Stripe secret key from Charity's existing Stripe account ("Armani").
# Leave EMPTY to run the shop in "checkout not configured yet" mode:
# pages render fine, but the buy button is disabled.
STRIPE_SECRET_KEY=

# Book price in USD. $4.99 is a placeholder until Charity confirms the real price.
STORE_PRICE_USD=4.99

# Tax code sent to Stripe with the checkout (her account uses Managed
# Payments, which requires one). txcd_10000000 is Stripe's general code —
# the same one the chat app uses.
STRIPE_TAX_CODE=txcd_10000000

# How long a buyer's download link stays valid, in seconds (default 24 hours).
DOWNLOAD_TOKEN_MAX_AGE=86400

# Set to 1 in production (https) so the session cookie is secure-only.
SECURE_COOKIES=0
